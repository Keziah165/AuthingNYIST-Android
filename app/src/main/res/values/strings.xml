<resources>
    <string name="app_name">NYIST Connect</string>
    <string name="app_subtitle">南阳理工学院校园网认证助手（安卓版）</string>

    <string name="network_label">校园网络</string>
    <string name="username_label">账号（按学校提供的完整账号填写）</string>
    <string name="username_hint">学校给的完整账号，如含 @ 后缀请一并填入（例如 2024xxxxxx@nyist-stu）。SSID 不等于账号后缀。</string>
    <string name="password_label">密码</string>

